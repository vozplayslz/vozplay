{
  "name": "vozplay",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "migrate": "tsx server/migrations/migrator.ts up",
    "migrate:status": "tsx server/migrations/migrator.ts status",
    "migrate:rollback": "tsx server/migrations/migrator.ts rollback",
    "lint": "tsc --noEmit",
    "test:core": "tsx scripts/verify-maia-core.ts",
    "test:context": "tsx scripts/verify-context-engine.ts",
    "test:tools": "tsx scripts/verify-tool-registry.ts",
    "test:events": "tsx scripts/verify-event-bus-perception.ts",
    "test:memory": "tsx scripts/verify-memory-engine.ts",
    "test:router": "tsx scripts/verify-ai-router.ts",
    "test:runtime": "tsx scripts/verify-agent-runtime.ts",
    "test:voice": "tsx scripts/verify-voice.ts",
    "test:autonomy": "tsx scripts/verify-autonomy.ts",
    "test:hardening": "tsx scripts/verify-hardening.ts",
    "test:blockers": "tsx scripts/verify-blockers-hardening.ts",
    "test:integration": "tsx scripts/verify-integration.ts",
    "test:e2e": "tsx scripts/verify-e2e-matrix.ts",
    "test": "tsx scripts/verify-maia-core.ts && tsx scripts/verify-context-engine.ts && tsx scripts/verify-tool-registry.ts && tsx scripts/verify-event-bus-perception.ts && tsx scripts/verify-memory-engine.ts && tsx scripts/verify-ai-router.ts && tsx scripts/verify-agent-runtime.ts && tsx scripts/verify-voice.ts && tsx scripts/verify-autonomy.ts && tsx scripts/verify-hardening.ts && tsx scripts/verify-blockers-hardening.ts && tsx scripts/verify-integration.ts && tsx scripts/verify-e2e-matrix.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@node-rs/argon2": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
