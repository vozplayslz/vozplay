# ==========================================================
# VOZPLAY - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# Dominio Oficial: vozplay.ai.slz.br
# ==========================================================

# 1. Porta de Escuta Única (HTTP REST + WebSockets)
PORT="3000"

# 2. Ambiente de Execução ('production' | 'development')
# Em produção, DATABASE_URL, SUPERVISOR_PASSWORD e CONTROLLER_PASSWORD são estritamente obrigatórios.
NODE_ENV="production"

# 3. Domínio Oficial da Plataforma
DOMAIN="vozplay.ai.slz.br"

# 4. Banco de Dados PostgreSQL 16 (Fonte Autoritativa de Dados)
DATABASE_URL="postgresql://vozplay_user:sua_senha_do_banco_aqui@db:5432/vozplay_db"

# 5. Credenciais Operacionais Mandatórias (Sem Senhas Hardcoded)
# Senhas são protegidas com Argon2id (RFC 9106)
SUPERVISOR_PASSWORD="DEFINA_SUA_SENHA_DE_SUPERVISOR_FORTE_AQUI"
CONTROLLER_PASSWORD="DEFINA_SUA_SENHA_DE_MESA_DE_SOM_FORTE_AQUI"

# 6. Modo de Demonstração (Padrão: false / desabilitado em produção)
# Definir como 'true' apenas para testes pontuais com cantores fictícios
SEED_DEMO="false"

# 7. Segredo Opcional para Criptografia de Tokens
AUTH_SECRET="DEFINA_UM_SEGREDO_DE_ALTA_ENTROPIA_HEX_32_BYTES"

# 8. Integração com Gemini AI (Playlists Curadas e Recomendações Vocais)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_AQUI"

# 9. URL Base do Applet (Injetado pelo ambiente de hospedagem)
APP_URL="https://vozplay.ai.slz.br"
