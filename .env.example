# ==========================================================
# VOZPLAY - TEMPLATE DE CONFIGURAÇÃO (.env.example)
# Todas as credenciais reais devem ser injetadas via ambiente.
# ==========================================================

PORT=3000
NODE_ENV=production
DOMAIN=vozplay.ai.slz.br

# PostgreSQL (Fonte Persistente Oficial)
DATABASE_URL=

# Credenciais Operacionais (Obrigatórias em Produção)
SUPERVISOR_PASSWORD=
CONTROLLER_PASSWORD=
ENCRYPTION_KEY=
AUTH_SECRET=

# Provedores de IA (Opcionais)
GEMINI_API_KEY=
ROUTER_GATEWAY_URL=https://9router.ai.slz.br
ROUTER_API_KEY=

# Modo de Demonstração (false por padrão em produção)
SEED_DEMO=false
APP_URL=https://vozplay.ai.slz.br
