# ==========================================================
# VOZPLAY - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# Dominio Oficial: vozplay.ai.slz.br
# ==========================================================

# 1. Porta de Escuta Única (HTTP REST + WebSockets)
PORT="3000"

# 2. Ambiente de Execução ('production' | 'development')
NODE_ENV="production"

# 3. Domínio Oficial da Plataforma
DOMAIN="vozplay.ai.slz.br"

# 4. Credenciais Operacionais Mandatórias (Sem Senhas Hardcoded)
# Senhas são protegidas com Argon2id (RFC 9106)
SUPERVISOR_PASSWORD="VozPlay@SuperAdmin2026!SLZ"
CONTROLLER_PASSWORD="VozPlay@SoundDesk704!SLZ"
ENCRYPTION_KEY="VozPlayVaultKeySLZ2026AlphaOmega32B"
AUTH_SECRET="VozPlayAuthSecretHexHighEntropy32BKeySLZ"

# 5. Modo de Demonstração (Padrão: false / desabilitado em produção)
SEED_DEMO="false"

# 6. URL Base do Applet
APP_URL="https://vozplay.ai.slz.br"
